generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contractor {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  gstNumber        String?
  address          String?
  phone            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  incidents        Incident[]
  labourCamps      LabourCamp[]
  legalCompliances LegalCompliance[]
  sites            Site[]
  systemUsers      SystemUser[]
  vehicles         Vehicle[]
  workers          Worker[]
}

model Site {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  address            String?
  contractorId       String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  hazardousMaterials HazardousMaterial[]
  incidents          Incident[]
  labourCamps        LabourCamp[]
  medInfraItems      MedInfraItem[]
  contractor         Contractor?         @relation(fields: [contractorId], references: [id])
  siteFacilities     SiteFacility[]
  siteSecurityItems  SiteSecurityItem[]
  systemUsers        SystemUser[]
  vehicles           Vehicle[]
  workers            Worker[]
}

model Designation {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   @default("General")
  description String?
  isActive    Boolean  @default(true)
  workers     Worker[]
}

model Worker {
  id                  String             @id @default(cuid())
  employeeNumber      String             @unique
  fullName            String
  dateOfBirth         DateTime
  age                 Int
  gender              String
  aadhaarNumber       String
  aadhaarScanPath     String?
  permanentAddress    String
  currentAddress      String?
  bloodGroup          String
  qualification       String
  qualificationNote   String?
  designationId       String
  contractorId        String
  siteId              String?
  zone                String?
  nativeState         String?
  policeRecords       String             @default("Not Updated")
  labourCampId        String?
  reportingSupervisor String?
  uanNumber           String?
  profilePhotoPath    String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  attendances         Attendance[]
  emergencyContacts   EmergencyContact[]
  incidents           IncidentWorker[]
  insurances          Insurance[]
  medicalRecords      MedicalRecord[]
  nominees            Nominee[]
  trainingRecords     TrainingRecord[]
  drivenVehicles      Vehicle[]          @relation("VehicleDriver")
  wageRecords         WageRecord[]
  contractor          Contractor         @relation(fields: [contractorId], references: [id])
  designation         Designation        @relation(fields: [designationId], references: [id])
  labourCamp          LabourCamp?        @relation(fields: [labourCampId], references: [id])
  site                Site?              @relation(fields: [siteId], references: [id])
  fitness             WorkerFitness?
}

model EmergencyContact {
  id           String  @id @default(cuid())
  workerId     String
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)
  worker       Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Nominee {
  id            String  @id @default(cuid())
  workerId      String
  name          String
  relationship  String
  idNumber      String?
  contactNumber String?
  worker        Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model WorkerFitness {
  id                      String    @id @default(cuid())
  workerId                String    @unique
  fitnessStatus           String    @default("Pending")
  fitnessCertificatePath  String?
  fitnessValidityDate     DateTime?
  totalExperienceYears    Float     @default(0)
  relevantExperienceYears Float     @default(0)
  relevantExperienceDesc  String?
  priorEmployer           String?
  skillLevel              String    @default("Unskilled")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  worker                  Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id                     String    @id @default(cuid())
  workerId               String
  examinationDate        DateTime
  examinationType        String    @default("PreEmployment")
  examiningDoctor        String?
  examiningFacility      String?
  result                 String    @default("Pending")
  previousHealthIssues   String?
  chronicDiseases        String?
  chronicDiseaseNotes    String?
  currentMedications     String?
  pastSurgeries          String?
  nextCheckupDate        DateTime?
  checkupFrequencyMonths Int       @default(12)
  certificatePath        String?
  photoPaths             String?
  photos                 String?
  remarks                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  worker                 Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model TrainingRecord {
  id                 String    @id @default(cuid())
  workerId           String
  trainingType       String
  trainingTitle      String
  dateConducted      DateTime
  durationHours      Float
  trainerName        String?
  trainerCredentials String?
  trainingAgency     String?
  certificateNumber  String?
  certificatePath    String?
  validityDate       DateTime?
  status             String    @default("Valid")
  isCompleted        Boolean   @default(false)
  photoPaths         String?
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  worker             Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Attendance {
  id            String   @id @default(cuid())
  workerId      String
  date          DateTime
  status        String   @default("Present")
  shiftTiming   String?
  isBiometric   Boolean  @default(false)
  overtimeHours Float?   @default(0)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
}

model Insurance {
  id                String    @id @default(cuid())
  workerId          String
  policyType        String
  policyNumber      String
  insurerName       String?
  coverageAmount    Float?
  validityStartDate DateTime?
  validityEndDate   DateTime?
  nomineeName       String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  worker            Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model WageRecord {
  id                String   @id @default(cuid())
  workerId          String
  month             String
  dailyRate         Float?
  monthlyRate       Float?
  wageCategory      String?
  workingDays       Int      @default(0)
  totalWages        Float    @default(0)
  overtimeAmount    Float    @default(0)
  deductionPF       Float    @default(0)
  deductionESI      Float    @default(0)
  deductionOther    Float    @default(0)
  netPay            Float    @default(0)
  bankAccountNumber String?
  uanNumber         String?
  pfContributionPct Float?   @default(12)
  employerPF        Float?   @default(0)
  employeePF        Float?   @default(0)
  esiNumber         String?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  worker            Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, month])
}

model Incident {
  id                 String             @id @default(cuid())
  incidentNumber     String             @unique
  incidentType       String
  date               DateTime
  time               String?
  locationOnSite     String?
  description        String
  rootCause          String?
  immediateAction    String?
  firstResponder     String?
  hospitalReferred   String?
  severity           String             @default("Medium")
  status             String             @default("Open")
  isDeath            Boolean            @default(false)
  policeFIRReference String?
  employerNotifiedAt DateTime?
  compensationStatus String?
  familyNotified     Boolean            @default(false)
  closureStatus      String?
  contractorId       String?
  siteId             String?
  photoPaths         String?
  photos             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  contractor         Contractor?        @relation(fields: [contractorId], references: [id])
  site               Site?              @relation(fields: [siteId], references: [id])
  followUps          IncidentFollowUp[]
  workers            IncidentWorker[]
}

model IncidentWorker {
  id         String   @id @default(cuid())
  incidentId String
  workerId   String?
  workerName String?
  injuryDesc String?
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  worker     Worker?  @relation(fields: [workerId], references: [id])
}

model IncidentFollowUp {
  id                String    @id @default(cuid())
  incidentId        String
  action            String
  dueDate           DateTime?
  responsiblePerson String?
  completed         Boolean   @default(false)
  completedAt       DateTime?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  incident          Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Grievance {
  id                String    @id @default(cuid())
  grievanceNumber   String    @unique
  dateRaised        DateTime  @default(now())
  raisedBy          String?
  raisedByName      String?
  category          String
  isPOSH            Boolean   @default(false)
  description       String
  severity          String    @default("Medium")
  assignedTo        String?
  status            String    @default("Open")
  resolutionDetails String?
  resolutionDate    DateTime?
  closedBy          String?
  photoPaths        String?
  photos            String?
  slaDays           Int       @default(7)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Vehicle {
  id                 String            @id @default(cuid())
  vehicleNumber      String
  vehicleType        String
  owner              String            @default("Contractor")
  condition          String            @default("Fit")
  lastInspectionDate DateTime?
  nextInspectionDue  DateTime?
  contractorId       String?
  siteId             String?
  driverId           String?
  photoPath          String?
  photos             String?
  currentQRCode      String?
  qrCodeHistory      String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  contractor         Contractor?       @relation(fields: [contractorId], references: [id])
  driver             Worker?           @relation("VehicleDriver", fields: [driverId], references: [id])
  site               Site?             @relation(fields: [siteId], references: [id])
  documents          VehicleDocument[]
}

model VehicleDocument {
  id         String    @id @default(cuid())
  vehicleId  String
  docType    String
  docNumber  String?
  issueDate  DateTime?
  expiryDate DateTime?
  uploadPath String?
  status     String    @default("Valid")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model HazardousMaterial {
  id                        String                @id @default(cuid())
  materialName              String
  category                  String                @default("General")
  hazardClassification      String?
  msdsUploadPath            String?
  photoPath                 String?
  photos                    String?
  storageLicenseNumber      String?
  storageLicenseExpiry      DateTime?
  quantityCurrent           Float                 @default(0)
  quantityMaxPermissible    Float
  unit                      String                @default("KG")
  storageLocation           String?
  storageConditionCompliant Boolean               @default(true)
  handlingResponsiblePerson String?
  emergencyProcedureRef     String?
  siteId                    String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  site                      Site?                 @relation(fields: [siteId], references: [id])
  transactions              MaterialTransaction[]
}

model MaterialTransaction {
  id              String            @id @default(cuid())
  materialId      String
  transactionType String
  quantity        Float
  runningBalance  Float
  date            DateTime          @default(now())
  remarks         String?
  createdAt       DateTime          @default(now())
  material        HazardousMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model LegalCompliance {
  id                  String     @id @default(cuid())
  contractorId        String
  complianceType      String
  licenseNumber       String?
  issuingAuthority    String?
  issueDate           DateTime?
  expiryDate          DateTime?
  renewalReminderDays Int        @default(30)
  status              String     @default("Valid")
  remarks             String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  contractor          Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model SiteFacility {
  id                 String    @id @default(cuid())
  siteId             String
  item               String
  status             String    @default("Compliant")
  lastInspectionDate DateTime?
  inspector          String?
  remarks            String?
  photos             String?
  records            String?
  usageDetails       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteSecurityItem {
  id                 String    @id @default(cuid())
  siteId             String
  item               String
  status             String    @default("Compliant")
  compliancePct      Float?    @default(100)
  lastInspectionDate DateTime?
  inspector          String?
  remarks            String?
  photos             String?
  records            String?
  usageDetails       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model MedInfraItem {
  id                 String    @id @default(cuid())
  siteId             String
  item               String
  status             String    @default("Compliant")
  details            String?
  lastInspectionDate DateTime?
  inspector          String?
  remarks            String?
  photos             String?
  records            String?
  usageDetails       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SystemUser {
  id           String      @id @default(cuid())
  username     String      @unique
  password     String
  fullName     String
  role         String
  contractorId String?
  siteId       String?
  profilePhoto String?
  isActive     Boolean     @default(true)
  lastLogin    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  site         Site?       @relation(fields: [siteId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  field     String?
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
}

model LabourCamp {
  id               String     @id @default(cuid())
  name             String
  contractorId     String
  siteId           String
  address          String?
  capacity         Int?
  currentOccupancy Int?       @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  contractor       Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  site             Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workers          Worker[]
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  priority   String   @default("Medium")
  createdAt  DateTime @default(now())
}
